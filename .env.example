# Copy to .env and fill in. The test suite needs NONE of these — it runs on fakes
# (see tests/fakes.py). These are only for running against real Fireworks + Stripe.

# --- LLM: Kimi K2.6 on Fireworks ---
FIREWORKS_API_KEY=
# Model slug is pinned in app/configs/llm.py; override here only to swap models.
# FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6

# --- Stripe (money state, source of truth for charges/refunds) ---
# Use a TEST key with Charges read + Refunds write. `python -m scripts.seed` will
# create real test charges with it.
STRIPE_API_KEY=
# Pin the API version so a Stripe-side upgrade can never silently change behavior.
STRIPE_API_VERSION=

# --- Fact store (embedded SQLite; no separate service) ---
# STORE_DB_PATH=refund_agent.db

# --- Service ---
PORT=8080
ENV=development

# --- Demo spend limits (defaults in app/configs/limits.py) ---
# LIMITS_REQUESTS_PER_HOUR=20
# LIMITS_BURST=8
# LIMITS_MAX_TURNS_PER_THREAD=20
# LIMITS_MAX_MESSAGE_CHARS=2000

# --- LangGraph dev server + Studio (the demo surface) ---
# Free key from https://smith.langchain.com/settings
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
