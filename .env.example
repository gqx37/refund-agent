# Copy to .env and fill in. The test suite needs NONE of these — it runs on
# deterministic stubs (see tests/ and app/stubs/). These are only for running
# the agent against the real Fireworks / Stripe / Neo4j.

# --- LLM: Nemotron 3 Ultra on Fireworks (the reasoning core of the harness) ---
FIREWORKS_API_KEY=
# Model slug is pinned in code (app/agent/llm.py); override here only to swap models.
# FIREWORKS_MODEL=accounts/fireworks/models/nemotron-3-ultra-nvfp4

# --- Stripe (money state, source of truth for charges/refunds) ---
# Use a RESTRICTED key. This agent needs: Charges read, Refunds write.
STRIPE_API_KEY=
# Pin the API version so a Stripe-side upgrade can never silently change behavior.
# Leave blank to use your account default. See docs/architecture.md.
STRIPE_API_VERSION=

# --- Neo4j (semantic fact store: Customer / Order / Transaction graph) ---
# Local: bolt://localhost:7687 . Fly (private 6PN): bolt://refund-agent-neo4j.internal:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Service ---
PORT=8080
ENV=development
