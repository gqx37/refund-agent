# Copy to .env.local for local development. Both are server-only — neither is
# prefixed NEXT_PUBLIC_, so neither is ever bundled into the browser.

# Where the agent runs. No trailing slash.
BACKEND_URL=https://refund-agent.fly.dev

# Must match PROXY_SHARED_SECRET on the Fly app. Generate one with:
#   openssl rand -hex 32
PROXY_SHARED_SECRET=
